<?xml version="1.0" encoding="UTF-8"?>
<launch>

	<!-- World Name -->
	<arg name="group"/>
	<arg name="world"/>

	<!-- Map server -->
	<arg name="map_file" default="$(find turtlebot_explorer_marker)/maps/$(arg world).yaml"/>
	<node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)">
		<remap from="map" to="gt_map"/>
	</node>

	<!-- AutoMarker -->
	<node pkg="turtlebot_explorer_marker" name="marker" type="marking_script.py" output="screen" required="True">
		<param name="group" value="$(arg group)"/>
		<param name="world" value="$(arg world)"/>
		<param name="duration" value="60"/>
	</node>

	<!-- Explorer -->
	<include file="$(find turtlebot_explorer)/launch/turtlebot_explorer.launch"/>

</launch>
