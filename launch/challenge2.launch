<?xml version="1.0" encoding="UTF-8"?>
<launch>

	<!-- World Name -->
	<arg name="group"/>
	<arg name="world"/>

	<!-- AutoMarker -->
	<node pkg="turtlebot_explorer_marker" name="marker" type="marking_script.py" output="screen" required="True">
		<param name="group" value="$(arg group)"/>
		<param name="world" value="$(arg world)"/>
		<param name="duration" value="180"/>
	</node>

	<!-- Explorer -->
	<include file="$(find turtlebot_explorer)/launch/turtlebot_explorer.launch"/>

</launch>
